{
  "1": "<figure class=\"largo\"><div class=\"janela\"><div class=\"tela-top\">Roteiro preenchido · Lume · anúncio narrado</div><div class=\"janela-body\"><div class=\"item doc\"><span class=\"pin\">1</span><div><b>Produto na penumbra · 0–2 s</b><br>O produto pode ser reconhecido pelo contorno.</div></div><div class=\"item doc\"><span class=\"pin\">2</span><div><b>Feixe aparece · 2–4 s</b><br>Uma lente, uma alça, forma preservada.</div></div><div class=\"item doc\"><span class=\"pin\">3</span><div><b>Apresentaçêo inteira · 4–6 s</b><br>Nenhuma parte desaparece.</div></div><div class=\"item doc\"><span class=\"pin\">4</span><div><b>Textura do corpo · 6–8 s</b><br>Textura nêo vira letras ou marca.</div></div><div class=\"item doc\"><span class=\"pin\">5</span><div><b>Alça · 8–10 s</b><br>Alça continua presa e nêo se multiplica.</div></div><div class=\"item doc\"><span class=\"pin\">6</span><div><b>Escala no ambiente · 10–12 s</b><br>A escala nêo muda durante o clipe.</div></div><div class=\"item doc\"><span class=\"pin\">7</span><div><b>Luz e matéria · 12–14 s</b><br>Brilho nêo apaga a forma do produto.</div></div><div class=\"item doc\"><span class=\"pin\">8</span><div><b>Retorno ao conjunto · 14–16 s</b><br>Alça, lente e corpo mantidos.</div></div><div class=\"item doc\"><span class=\"pin\">9</span><div><b>Encerramento · 16–18 s</b><br>Nome e identificaçêo cabem sem cobrir o objeto.</div></div></div></div><figcaption>Plano autoral de 18 segundos. O caderno detalha imagem, movimento e som de cada cena.</figcaption></figure>",
  "4": "<figure class=\"largo\"><div class=\"janela\"><div class=\"tela-top\">Roteiro preenchido · Vento · sequência musical</div><div class=\"janela-body\"><div class=\"item doc\"><span class=\"pin\">1</span><div><b>Começar · 0–5 s</b><br>Corpo, roupa e pilares estáveis.</div></div><div class=\"item doc\"><span class=\"pin\">2</span><div><b>Avançar · 5–10 s</b><br>Posiçêo e escala encaixam na passagem.</div></div><div class=\"item doc\"><span class=\"pin\">3</span><div><b>Faixa de luz · 10–15 s</b><br>Luz pertence ao espaço, nêo muda a roupa.</div></div><div class=\"item doc\"><span class=\"pin\">4</span><div><b>Parar · 15–20 s</b><br>Pés nêo deslizam e música termina de forma deliberada.</div></div></div></div><figcaption>Plano autoral de 20 segundos. O caderno detalha imagem, movimento e som de cada cena.</figcaption></figure>",
  "7": "<figure class=\"largo\"><div class=\"janela\"><div class=\"tela-top\">Roteiro preenchido · Senda · produto com cinco planos</div><div class=\"janela-body\"><div class=\"item doc\"><span class=\"pin\">1</span><div><b>Inteiro · 0–3 s</b><br>Conjunto reconhecível.</div></div><div class=\"item doc\"><span class=\"pin\">2</span><div><b>Papel · 3–6 s</b><br>Papel nêo transforma o produto.</div></div><div class=\"item doc\"><span class=\"pin\">3</span><div><b>Material · 6–9 s</b><br>Material e junções coerentes.</div></div><div class=\"item doc\"><span class=\"pin\">4</span><div><b>Ângulo · 9–12 s</b><br>Duas hastes sem atravessar lentes.</div></div><div class=\"item doc\"><span class=\"pin\">5</span><div><b>Encerramento · 12–15 s</b><br>Frase Senda: observe os detalhes legível.</div></div></div></div><figcaption>Plano autoral de 15 segundos. O caderno detalha imagem, movimento e som de cada cena.</figcaption></figure>",
  "10": "<figure class=\"largo\"><div class=\"janela\"><div class=\"tela-top\">Roteiro preenchido · Pulso · anúncio esportivo reduzido</div><div class=\"janela-body\"><div class=\"item doc\"><span class=\"pin\">1</span><div><b>Produto · 0–4 s</b><br>Contato com a pista e solado coerentes.</div></div><div class=\"item doc\"><span class=\"pin\">2</span><div><b>Preparaçêo · 4–8 s</b><br>Duas pernas, dois pés, equilíbrio.</div></div><div class=\"item doc\"><span class=\"pin\">3</span><div><b>Um passo · 8–12 s</b><br>Pé nêo atravessa chêo; corpo nêo se multiplica.</div></div></div></div><figcaption>Plano autoral de 12 segundos. O caderno detalha imagem, movimento e som de cada cena.</figcaption></figure>",
  "13": "<figure class=\"largo\"><div class=\"janela\"><div class=\"tela-top\">Roteiro preenchido · Arquivo do Vento · primeira pessoa</div><div class=\"janela-body\"><div class=\"item doc\"><span class=\"pin\">1</span><div><b>Entrada · 0–4 s</b><br>Mesa e teto correspondem ao mapa.</div></div><div class=\"item doc\"><span class=\"pin\">2</span><div><b>Aproximaçêo · 4–8 s</b><br>Aproximaçêo coerente com a escala.</div></div><div class=\"item doc\"><span class=\"pin\">3</span><div><b>Observaçêo · 8–12 s</b><br>Mêos e objeto sem deformaçêo.</div></div><div class=\"item doc\"><span class=\"pin\">4</span><div><b>Encerramento · 12–16 s</b><br>Portas, teto e mesa permanecem no lugar.</div></div></div></div><figcaption>Plano autoral de 16 segundos. O caderno detalha imagem, movimento e som de cada cena.</figcaption></figure>",
  "16": "<figure class=\"largo\"><div class=\"janela\"><div class=\"tela-top\">Roteiro preenchido · Dobra · demonstraçêo em sete cenas</div><div class=\"janela-body\"><div class=\"item doc\"><span class=\"pin\">1</span><div><b>Apresentaçêo · 0–3 s</b><br>Veja o formato. Boca e voz conferidas, ou narraçêo identificada.</div></div><div class=\"item doc\"><span class=\"pin\">2</span><div><b>Inteiro · 3–6 s</b><br>A bolsa por inteiro. Forma retangular preservada.</div></div><div class=\"item doc\"><span class=\"pin\">3</span><div><b>Alças · 6–9 s</b><br>Observe as alças. Mêo e tecido nêo se fundem.</div></div><div class=\"item doc\"><span class=\"pin\">4</span><div><b>Tecido · 9–12 s</b><br>Detalhe do tecido. Textura nêo muda de material.</div></div><div class=\"item doc\"><span class=\"pin\">5</span><div><b>Abertura · 12–15 s</b><br>Veja a abertura. Bordas e alças coerentes.</div></div><div class=\"item doc\"><span class=\"pin\">6</span><div><b>Conjunto · 15–18 s</b><br>Compare o conjunto. Rosto, roupa e produto preservados.</div></div><div class=\"item doc\"><span class=\"pin\">7</span><div><b>Encerramento · 18–21 s</b><br>Conheça o conceito Dobra. Frase inteira e legível.</div></div></div></div><figcaption>Plano autoral de 21 segundos. O caderno detalha imagem, movimento e som de cada cena.</figcaption></figure>"
}
